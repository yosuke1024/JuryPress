# JuryPress - Environment Variables Example

# Gemini API Key for generation (Primary)
GEMINI_API_KEY=
GEMINI_FALLBACK_API_KEY=
GEMINI_PRIMARY_MAX_ATTEMPTS=3
GEMINI_FALLBACK_MAX_ATTEMPTS=3

# Specific model override (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Base URL for Astro build (set in CI automatically for GitHub Pages, e.g., /JuryPress)
# BASE_URL=/JuryPress
# SITE_URL=https://yosuke1024.github.io

# Analytics (Public)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Ads (Public) — which network serves is decided by the IDs this build carries:
# an AdSense client wins, otherwise AdMax frames are used, otherwise no ads.
# See src/lib/ads.ts.

# AdSense: responsive in-article units.
PUBLIC_ADSENSE_ENABLED=false
PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT_ARTICLE_1=1111111111
PUBLIC_ADSENSE_SLOT_ARTICLE_2=2222222222
PUBLIC_ADSENSE_SLOT_RANKING=3333333333

# 忍者AdMax: fixed-size frames, one per placement PER DEVICE CATEGORY. Create
# each as an INLINE frame under the matching category, at the size that
# category's box reserves (src/lib/ads.ts): PC 300x250, smartphone 320x50.
# Register the site URL of a page that actually carries the tag — a review
# article, not the section index. Values are the 32 hex characters from the
# console's tag URL. A frame ID must not appear twice on one page, so all four
# are distinct.
PUBLIC_ADMAX_ENABLED=false
PUBLIC_ADMAX_ARTICLE_1_PC=
PUBLIC_ADMAX_ARTICLE_1_SP=
PUBLIC_ADMAX_ARTICLE_2_PC=
PUBLIC_ADMAX_ARTICLE_2_SP=

# External Linking (Public)
PUBLIC_JUDGIE_URL=https://github.com/yosuke1024/Judgie-AI
PUBLIC_PIXAPPS_URL=https://pixapps.ai/
